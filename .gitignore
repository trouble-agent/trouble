# Container secret material (mounted at run time, never committed).
deploy/container/secrets/

# Local runtime scratch that must never be swept into a commit:
# DuckBrain write staging (nested repo with its own .git) and GitReins run logs.
namespaces/
.gitreins/logs/
.gitreins/tasks.yaml.lock

# Build artifacts from make bin / go build. Root-anchored on purpose: a bare
# `trouble` also matches the cmd/trouble/ DIRECTORY, which hides new files in the
# CLI package from `git add` (the binary lives at ./trouble, ./troubled,
# ./resolved; bin/ is ignored above).
/trouble
/troubled
/resolved
